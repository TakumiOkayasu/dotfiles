#!/bin/sh
# codex-cmd - short alias for codex-prompt run
#
# Usage:
#   codex-cmd feat "ユーザー検索"
#   codex-cmd deep-review

set -eu

CMD="${1:-}"
if [ -z "$CMD" ]; then
    echo "usage: codex-cmd <prompt-name> [arguments...]" >&2
    exit 1
fi
shift || true

SCRIPT_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P || dirname "$0")
exec "$SCRIPT_DIR/codex-prompt" run "/prompt:${CMD}" "$@"
