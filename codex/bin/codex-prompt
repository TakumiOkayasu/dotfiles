#!/bin/sh
# codex-prompt - repo-local prompt command utility
#
# Usage:
#   codex-prompt list
#   codex-prompt expand /prompt:feat "ユーザー検索"
#   codex-prompt run /prompt:feat "ユーザー検索"

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P || dirname "$0")
CODEX_DIR=$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P || echo "$HOME/.codex")
COMMAND_DIR="${CODEX_PROMPT_DIR:-$CODEX_DIR/prompts/commands}"

usage() {
    cat <<'EOF'
usage:
  codex-prompt list
  codex-prompt expand /prompt:<name> [arguments...]
  codex-prompt run /prompt:<name> [arguments...]
  codex-prompt cat <name>
EOF
}

list_commands() {
    [ -d "$COMMAND_DIR" ] || return 0
    find "$COMMAND_DIR" -maxdepth 1 -type f -name '*.md' | sed 's#.*/##; s#\.md$##' | sort
}

resolve_name() {
    name="$1"
    case "$name" in
        /prompt:*) name=${name#/prompt:} ;;
        /prompt) shift; name="${1:-}" ;;
    esac
    case "$name" in
        *[!A-Za-z0-9_-]*|'')
            echo "invalid prompt name: $name" >&2
            exit 1
            ;;
    esac
    printf '%s\n' "$name"
}

render_prompt() {
    name="$1"
    shift || true
    args="$*"
    file="$COMMAND_DIR/$name.md"
    if [ ! -f "$file" ]; then
        echo "unknown prompt: $name" >&2
        echo "available:" >&2
        list_commands >&2
        exit 1
    fi
    awk -v args="$args" '{ gsub(/\$ARGUMENTS/, args); print }' "$file"
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage >&2; exit 1; }
shift || true

case "$cmd" in
    list)
        list_commands
        ;;
    cat)
        name=$(resolve_name "${1:-}")
        cat "$COMMAND_DIR/$name.md"
        ;;
    expand)
        name=$(resolve_name "${1:-}")
        shift || true
        render_prompt "$name" "$@"
        ;;
    run)
        name=$(resolve_name "${1:-}")
        shift || true
        prompt=$(render_prompt "$name" "$@")
        exec codex "$prompt"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "unknown subcommand: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
