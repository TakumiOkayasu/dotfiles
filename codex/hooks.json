{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh pre-tool-use",
            "timeout": 30,
            "statusMessage": "Checking tool safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh post-tool-use",
            "timeout": 30,
            "statusMessage": "Recording session context"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh post-tool-use",
            "timeout": 30,
            "statusMessage": "Checking rules compliance"
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write|MultiEdit|ApplyPatch"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh user-prompt-submit",
            "timeout": 30,
            "statusMessage": "Checking prompt context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh pre-compact",
            "timeout": 30,
            "statusMessage": "Saving compact checkpoint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh session-start",
            "timeout": 30,
            "statusMessage": "Loading session guidance"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/hook-dispatcher.sh stop",
            "timeout": 30,
            "statusMessage": "Final rules compliance check"
          }
        ]
      }
    ]
  }
}
