{
  "env": {
    "EDITOR": "code --wait",
    "VISUAL": "code --wait"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "WebFetch"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.env)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -f *)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/hook-dispatcher.sh pre-tool-use",
            "timeout": 30,
            "statusMessage": "Checking tool safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/hook-dispatcher.sh post-tool-use",
            "timeout": 30,
            "statusMessage": "Recording session context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/hook-dispatcher.sh user-prompt-submit",
            "timeout": 30,
            "statusMessage": "Checking prompt context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/hook-dispatcher.sh pre-compact",
            "timeout": 30,
            "statusMessage": "Saving compact checkpoint"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/hook-dispatcher.sh session-start",
            "timeout": 30,
            "statusMessage": "Loading session guidance"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "codex/bin/statusline-command.sh"
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "effortLevel": "high",
  "fastMode": true,
  "showThinkingSummaries": true,
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true
}
