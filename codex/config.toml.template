#:schema https://developers.openai.com/codex/config-schema.json
model = "gpt-5.6-sol"
model_reasoning_effort = "xhigh"
model_context_window = 1000000
model_auto_compact_token_limit = 900000

[agents]
enabled = true
max_concurrent_threads_per_session = 100
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "max"

[tui]
status_line = [
  "model-with-reasoning", # 推論機能付きのモデル名
  "fast-mode",            # Fast modeのON/OFF状態
  "current-dir",          # カレントディレクトリ
  "git-branch",           # Gitのブランチ名
  "context-remaining",    # コンテキストの残り容量（%）
  "five-hour-limit",      # 5時間制限の残り枠（%）
  "weekly-limit",         # 1週間制限の残り枠（%）
]
status_line_use_colors = true

[features]
hooks = true
memories = true
network_proxy = true
prevent_idle_sleep = true
default_mode_request_user_input = true

#[mcp_servers.github]
#bearer_token_env_var = "CODEX_GITHUB_PERSONAL_ACCESS_TOKEN"

[[hooks.PreToolUse]]
matcher = "Bash|Read|Edit|Write|apply_patch"

[[hooks.PreToolUse.hooks]]
type = "command"
command = "$HOME/.codex/hooks/hook-dispatcher.sh pre-tool-use"
timeout = 30
statusMessage = "Checking tool safety"

[[hooks.PostToolUse]]
matcher = "Bash|apply_patch|Edit|Write|MultiEdit|ApplyPatch"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "$HOME/.codex/hooks/hook-dispatcher.sh post-tool-use"
timeout = 30
statusMessage = "Recording session context and checking rules compliance"

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "$HOME/.codex/hooks/hook-dispatcher.sh user-prompt-submit"
timeout = 30
statusMessage = "Checking prompt context"

[[hooks.PreCompact]]

[[hooks.PreCompact.hooks]]
type = "command"
command = "$HOME/.codex/hooks/hook-dispatcher.sh pre-compact"
timeout = 30
statusMessage = "Saving compact checkpoint"

[[hooks.SessionStart]]

[[hooks.SessionStart.hooks]]
type = "command"
command = "$HOME/.codex/hooks/hook-dispatcher.sh session-start"
timeout = 30
statusMessage = "Loading session guidance"

[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = "$HOME/.codex/hooks/hook-dispatcher.sh stop"
timeout = 30
statusMessage = "Final rules compliance check"

[desktop]
ambient-suggestions-enabled = true
appearanceLightCodeThemeId = "github"
appearanceDarkCodeThemeId = "ayu"
codeFontSize = 14
usePointerCursors = true
dictationDictionary = []
composerEnterBehavior = "cmdIfMultiline"
git-pull-request-merge-method = "merge"
git-show-sidebar-pr-icons = true
conversationDetailMode = "STEPS_COMMANDS"

[desktop.appearanceLightChromeTheme]
accent = "#0969da"
contrast = 45
ink = "#1f2328"
opaqueWindows = false
surface = "#ffffff"

[desktop.appearanceLightChromeTheme.fonts]

[desktop.appearanceLightChromeTheme.semanticColors]
diffAdded = "#1a7f37"
diffRemoved = "#cf222e"
skill = "#8250df"

[desktop.appearanceDarkChromeTheme]
accent = "#e6b450"
contrast = 74
ink = "#bfbdb6"
opaqueWindows = false
surface = "#0b0e14"

[desktop.appearanceDarkChromeTheme.semanticColors]
diffAdded = "#7fd962"
diffRemoved = "#ea6c73"
skill = "#cda1fa"

[shell_environment_policy]
inherit = "core"

[shell_environment_policy.set]
EDITOR = "zed"
VISUAL = "zed"
