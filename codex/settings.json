{
  "env": {
    "EDITOR": "code --wait",
    "VISUAL": "code --wait"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "WebFetch"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.env)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -f *)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/destructive-command-block.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/docker-build-check.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/language-version-check.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/local-command-block.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/admin-command-block.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/secret-leak-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/env-file-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/main-branch-code-warning.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/commit-checkpoint.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/context-monitor.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/gh-repo-auto-setup.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/context-monitor.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/primary-source-check.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/methodology-skill-reminder.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/pre-compact-backup.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex/hooks/session-start-reminder.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/session-resume.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/project-environment-check.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/vendor-skills-update.sh"
          },
          {
            "type": "command",
            "command": "codex/hooks/primary-source-reminder.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "codex/bin/statusline-command.sh"
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "effortLevel": "high",
  "fastMode": true,
  "showThinkingSummaries": true,
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true
}
