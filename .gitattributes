# Default: treat as text, normalize to LF on checkout
* text=auto eol=lf

# Windows-native scripts: keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary (be explicit so they are never normalized)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
