{
  "env": {
    "EDITOR": "code --wait",
    "VISUAL": "code --wait"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "WebFetch"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.env)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -f *)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/docker-build-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/language-version-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/local-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/admin-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-leak-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/env-file-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/main-branch-code-warning.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-checkpoint.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/context-monitor.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/gh-repo-auto-setup.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/failure-log.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-cleanup-notes-archive.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-monitor.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/primary-source-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/methodology-skill-reminder.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-backup.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-resume.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-environment-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/vendor-skills-update.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/primary-source-reminder.sh"
          },
          {
            "matcher": "startup|resume",
            "hooks": [
                {
                "type": "command",
                "command": "~/.claude/hooks/session-start-notes-loader.sh",
                "timeout": 5
                }
            ]
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/bin/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "git@github.com:anthropics/claude-plugins-official.git"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "/home/okayasu/.claude/plugins/data",
        "/home/okayasu/.codex"
      ]
    }
  },
  "effortLevel": "xhigh",
  "fastMode": false,
  "showThinkingSummaries": true,
  "theme": "dark-daltonized",
  "skipAutoPermissionPrompt": true
}
