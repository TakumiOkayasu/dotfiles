      "Bash(xargs:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(source:*)",
      "Bash(bash:*)",
      "Bash(unzip:*)",
      "Bash(set -a)",
      "Bash(set +a)",
      "Bash(for:*)",
      "Bash(node:*)",
      "Bash(php:*)",
      "Bash(env)",
      "Bash(getconf:*)",
      "Bash(ping:*)",
      "Bash(xxd:*)",
      "Bash(curl:*)",
      "Bash(mysql:*)",
      "Bash(timeout:*)",
