      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git pull:*)",
      "Bash(git cat-file:*)",
      "Bash(git update-index:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config:*)",
      "Bash(git reset:*)",
      "Bash(git status:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose:*)",
      "Bash(docker run:*)",
      "Bash(docker ps:*)",
      "Bash(docker cp:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker system:*)",
      "Bash(docker build:*)",
      "Bash(docker rmi:*)",
      "Bash(docker-compose:*)",
      "Bash(composer:*)",
      "Bash(npm:*)",
      "Bash(brew install:*)",
      "Bash(uv:*)",
      "Bash(eslint:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/phpcs:*)",
      "Bash(ssh:*)",
      "Bash(ssh-add:*)",
      "Bash(scp:*)",
      "Bash(gh:*)",
      "Bash(glab:*)",
      "Bash(git-new-feature:*)",
      "Bash(./dbash.sh:*)",
      "Bash(./mms-dev.sh:*)",
      "Bash(ip:*)",
      "Read(//home/okayasu/prog/**)",
      "Read(//mnt/c/Users/okayasu/Pictures/Screenshots/**)",
      "WebFetch(domain:127.0.0.1)",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode",
      "Skill(review)"
    ],
    "deny": [
      ".env"
    ],
    "defaultMode": "plan"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/git-commit-push-block.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/docker-build-check.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/language-version-check.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/local-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/admin-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/env-file-protect.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/secret-leak-check.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/env-file-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/main-branch-code-warning.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/env-file-protect.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/main-branch-code-warning.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/branch-from-main-check.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/git-post-command-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/commit-checkpoint.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/context-monitor.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/doc-consistency-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/hierarchical-architecture-naming-check.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/doc-consistency-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/hierarchical-architecture-naming-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/context-monitor.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/pre-compact-backup.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/session-start-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/session-resume.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "language": "japanese",
  "autoUpdatesChannel": "latest"
}
