      "Bash(__NEW_LINE_599b9ac21dea8f6c__ docker exec webapp python3 -c \"\nimport openpyxl\nimport json\n\ndate_str = ''01/31''\nconfirmer = ''岡安''\n\n# 結果読み込み\nwith open\\(''/tmp/excel_test/test_results_detail.json'', encoding=''utf-8''\\) as f:\n    results = json.load\\(f\\)\n\n# 結果をシート+行でマッピング\nresult_map = {}\nfor r in results:\n    key = \\(r[''file''], r[''sheet''], r[''row'']\\)\n    result_map[key] = r\n\n# 林.xlsx更新\nwb1 = openpyxl.load_workbook\\(''/tmp/excel_test/テスト仕様書_林.xlsx''\\)\nsheets_林 = [''生材在庫一覧'', ''生材入庫'', ''生材出庫'', ''ベンダー機械割り当て'', ''ベンダー製造指示一覧'']\n\nfor sheet_name in sheets_林:\n    if sheet_name in wb1.sheetnames:\n        ws = wb1[sheet_name]\n        updated = 0\n        for row in range\\(6, ws.max_row + 1\\):\n            e_val = ws.cell\\(row=row, column=5\\).value\n            if e_val:\n                key = \\(''林'', sheet_name, row\\)\n                if key in result_map:\n                    r = result_map[key]\n                    ws.cell\\(row=row, column=9\\).value = r.get\\(''result'', ''OK''\\)\n                    ws.cell\\(row=row, column=10\\).value = date_str\n                    ws.cell\\(row=row, column=11\\).value = confirmer\n                    updated += 1\n        print\\(f''林/{sheet_name}: {updated}行''\\)\n\nwb1.save\\(''/tmp/excel_test/テスト仕様書_林.xlsx''\\)\n\n# 岡安.xlsx更新\nwb2 = openpyxl.load_workbook\\(''/tmp/excel_test/テスト仕様書_岡安担当_追加分.xlsx''\\)\nfor sheet_name in [''パネル製造指示画面（邸別）'', ''外注製品在庫一覧'']:\n    if sheet_name in wb2.sheetnames:\n        ws = wb2[sheet_name]\n        updated = 0\n        for row in range\\(6, ws.max_row + 1\\):\n            e_val = ws.cell\\(row=row, column=5\\).value\n            if e_val:\n                key = \\(''岡安'', sheet_name, row\\)\n                if key in result_map:\n                    r = result_map[key]\n                    ws.cell\\(row=row, column=9\\).value = r.get\\(''result'', ''OK''\\)\n                    ws.cell\\(row=row, column=10\\).value = date_str\n                    ws.cell\\(row=row, column=11\\).value = confirmer\n                    updated += 1\n        print\\(f''岡安/{sheet_name}: {updated}行''\\)\n\nwb2.save\\(''/tmp/excel_test/テスト仕様書_岡安担当_追加分.xlsx''\\)\nprint\\(''Excel更新完了''\\)\n\")",
