{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(du:*)",
      "Bash(unzip:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(xxd:*)",
      "Bash(source:*)",
      "Bash(for:*)",
      "Bash(getconf:*)",
      "Bash(ip:*)",
      "Bash(ping:*)",
      "Bash(curl:*)",
      "Bash(ssh:*)",
      "Bash(ssh-add:*)",
      "Bash(scp:*)",
      "Bash(mysql:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(glab:*)",
      "Bash(git-new-feature:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(brew install:*)",
      "WebFetch",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode",
      "Skill(review)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/git-commit-push-block.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/docker-build-check.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/language-version-check.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/local-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/admin-command-block.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/secret-leak-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/env-file-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/main-branch-code-warning.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/commit-checkpoint.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/context-monitor.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/gh-repo-auto-setup.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/context-monitor.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/pre-compact-backup.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/session-start-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/session-resume.sh"
          },
          {
            "type": "command",
            "command": "~/prog/dotfile-work/claude/hooks/project-environment-check.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "git@github.com:anthropics/claude-plugins-official.git"
      }
    }
  },
  "language": "japanese"
}