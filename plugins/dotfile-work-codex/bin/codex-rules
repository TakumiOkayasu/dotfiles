#!/bin/sh
# codex-rules - inspect dotfile-work Codex markdown rules.
set -eu

CMD="${1:-status}"
CWD=$(pwd)

find_rule_dirs() {
    [ -d "${PLUGIN_ROOT:-}/rules" ] && printf '%s\n' "${PLUGIN_ROOT}/rules"
    [ -d "$HOME/.codex/rules" ] && printf '%s\n' "$HOME/.codex/rules"
    [ -d "$CWD/.codex/rules" ] && printf '%s\n' "$CWD/.codex/rules"
    [ -d "$CWD/codex/rules" ] && printf '%s\n' "$CWD/codex/rules"
    if command -v git >/dev/null 2>&1; then
        ROOT=$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null || true)
        [ -n "$ROOT" ] && [ -d "$ROOT/codex/rules" ] && printf '%s\n' "$ROOT/codex/rules"
        [ -n "$ROOT" ] && [ -d "$ROOT/.codex/rules" ] && printf '%s\n' "$ROOT/.codex/rules"
    fi
}

rule_files() {
    find_rule_dirs | while IFS= read -r d; do
        find -L "$d" -maxdepth 1 -type f -name '*.md' 2>/dev/null
    done | sort -u
}

first_named() {
    name="$1"
    find_rule_dirs | while IFS= read -r d; do
        [ -f "$d/$name" ] && { printf '%s\n' "$d/$name"; exit 0; }
    done | sed -n '1p'
}

case "$CMD" in
    list)
        rule_files
        ;;
    core)
        f=$(first_named RULES_CORE.md || true)
        [ -n "$f" ] && cat "$f" || { echo "RULES_CORE.md not found" >&2; exit 1; }
        ;;
    index)
        f=$(first_named RULES_INDEX.md || true)
        [ -n "$f" ] && cat "$f" || { echo "RULES_INDEX.md not found" >&2; exit 1; }
        ;;
    bundle|read|full)
        f=$(first_named RULES_BUNDLE.md || true)
        if [ -n "$f" ]; then
            cat "$f"
        else
            rule_files | while IFS= read -r f; do printf '\n---\n# %s\n\n' "$f"; cat "$f"; done
        fi
        ;;
    status|check)
        echo "Rule dirs:"
        find_rule_dirs | sed 's/^/- /'
        echo ""
        echo "Rule files:"
        rule_files | sed 's/^/- /'
        echo ""
        marker="$CWD/codex_tmp/.codex_rules_loaded"
        if [ -f "$marker" ]; then
            echo "Marker: $marker"
            cat "$marker"
        else
            echo "Marker: not found"
        fi
        ;;
    *)
        cat <<EOF
usage: codex-rules [status|list|core|index|bundle|read|full|check]
EOF
        exit 2
        ;;
esac
