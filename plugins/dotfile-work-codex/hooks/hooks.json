{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/rules-inject.sh",
            "timeout": 30,
            "statusMessage": "Loading core dotfile-work rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/rules-inject.sh",
            "timeout": 30,
            "statusMessage": "Checking rule scope"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|apply_patch|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/rules-guard.sh",
            "timeout": 30,
            "statusMessage": "Checking mandatory rules"
          }
        ]
      }
    ]
  }
}
