# Git設定 - 仕事用 (install.sh が .gitconfig.common の後ろに結合する)

[user]
    email = t.okayasu@twb.jp

[url "git@gitlab.twb.jp:"]
    insteadOf = https://gitlab.twb.jp/

[core]
    quotePath = false
[push]
	autoSetupRemote = true

[credential "https://github.com"]
	helper = 
	helper = !~/.local/share/mise/shims/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !~/.local/share/mise/shims/gh auth git-credential
