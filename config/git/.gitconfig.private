[init]
        defaultBranch = main
[user]
	name = Takumi
        email = takumi_okys@icloud.com
[alias]
        s = status
        ss = status -s
        co = checkout
        br-rename = branch -m
        brd = branch -d
        cob = checkout -b
        adu = add -u
        cmt = commit -m
        undo = "!f() { git reset --hard $(git rev-parse --abbrev-ref HEAD)@{${1-1}} && git checkout $(git rev-parse --abbrev-ref HEAD); }; f"
[core]
        editor = code --wait
        symlinks = true
        excludesfile = ~/.gitignore_global
        compression = 1
[safe]
        directory = ~/prog
[credential "https://github.com"]
        helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
        helper = !/opt/homebrew/bin/gh auth git-credential
[http]
	postBuffer = 524288000
	version = HTTP/1.1
	lowSpeedLimit = 1000
	lowSpeedTime = 600
[pack]
        windowMemory = 256m
[fetch]
	prune = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
