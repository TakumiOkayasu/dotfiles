# Global gitattributes (linked to ~/.config/git/attributes)
# .gitattributes が無いリポジトリでも改行コード変換を抑止するための保険。
# core.autocrlf=true 環境でも LF を維持する。

# Default: text 自動判定 + LF 固定 (チェックアウト時に CRLF へ変換しない)
* text=auto eol=lf

# Windows ネイティブスクリプトは CRLF 維持
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary (改行変換対象外を明示)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
