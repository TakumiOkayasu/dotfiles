# Git共通設定
# work/privateの.gitconfigから include で読み込む

[init]
    defaultBranch = main

[alias]
    s = status
    ss = status -s
    co = checkout
    br-rename = branch -m
    brd = branch -d
    cob = checkout -b
    adu = add -u
    cmt = commit -m
    undo = "!f() { git reset --hard $(git rev-parse --abbrev-ref HEAD)@{${1-1}} && git checkout $(git rev-parse --abbrev-ref HEAD); }; f"

[core]
    editor = code --wait
    symlinks = true
    excludesfile = ~/.gitignore
    compression = 1
    pager = delta

[safe]
    directory = ~/prog

[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential
[credential]
    helper = store

[http]
    postBuffer = 524288000
    version = HTTP/1.1
    lowSpeedLimit = 1000
    lowSpeedTime = 600

[sendpack]
    sideband = false

[pack]
    windowMemory = 256m

[fetch]
    prune = true

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process

[include]
    path = ~/.gitconfig.local

[interactive]
    diffFilter = delta --color-only

[delta]
    # use n and N to move between diff sections
    navigate = true
    word-diff-regex = "[a-zA-Z0-9_]+|\\p{Hiragana}+|[\\p{Katakana}ー]+|[\\p{Han}〆]+|."
    line-numbers = true
    side-by-side = true
    wrap-max-lines = unlimited
    minus-non-emph-style = syntax
    plus-non-emph-style = syntax

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default