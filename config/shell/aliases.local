# shell/aliases.local - ローカル/カスタムエイリアス
#
# 用途: aliases.sh に含めない個人的なエイリアス定義
# 読み込み元: shell/aliases.sh

# ============================================================================
# 追加エイリアス
# ============================================================================

alias pshttpd='ps aux | grep httpd'
alias .='source'

# ============================================================================
# ls カスタマイズ (OS別)
# ============================================================================

if [ "$(uname)" = "Darwin" ]; then
    # macOS - gls (GNU ls from coreutils)
    if command -v gls >/dev/null 2>&1; then
        alias lla='gls -alh --color=auto --group-directories-first --time-style=long-iso'
        alias ls='gls -lh --color=auto --group-directories-first'
    fi
else
    # Linux (GNU ls)
    alias lla='ls -alXv --human-readable --time-style=long-iso --group-directories-first --color=auto'
fi

# ============================================================================
# クリップボード (プラットフォーム別、aliases.sh/local/*.sh と重複しない場合)
# ============================================================================

