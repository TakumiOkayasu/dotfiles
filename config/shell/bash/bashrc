#!/bin/bash
# config/shell/bash/bashrc - bash固有設定
#
# 配置先: ~/.bashrc (シンボリックリンク)
# 読み込み: 対話シェル起動時

# Git Bashのとき
if [[ -n "$MSYSTEM" ]]; then
    export MSYS=winsymlinks:nativestrict
fi

# ============================================================================
# 非対話シェルは即終了
# ============================================================================

case $- in
    *i*) ;;
    *) return ;;
esac

# ============================================================================
# DOTFILES_DIR 検出
# ============================================================================

_bashrc_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$(dirname "$(dirname "$_bashrc_dir")")")}"
unset _bashrc_dir

# ============================================================================
# SSH Agent 自動起動
# ============================================================================

if [[ -f "$DOTFILES_DIR/config/shell/ssh-agent.sh" ]]; then
    source "$DOTFILES_DIR/config/shell/ssh-agent.sh"
fi

# ============================================================================
# 共通設定の読み込み
# ============================================================================

# 共通設定を読み込み
if [[ -f "$HOME/.shell_common" ]]; then
    source "$HOME/.shell_common"
elif [[ -f "$DOTFILES_DIR/config/shell/common.sh" ]]; then
    source "$DOTFILES_DIR/config/shell/common.sh"
fi

# ============================================================================
# bash オプション
# ============================================================================

# ヒストリ設定
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S "
HISTIGNORE="ls:cd:pwd:exit:clear:history"

shopt -s histappend      # ヒストリを追記
shopt -s cmdhist         # 複数行コマンドを1行で保存
shopt -s lithist         # 複数行コマンドの改行を保持

# ディレクトリ
shopt -s autocd          # ディレクトリ名だけで cd
shopt -s cdspell         # cd のタイプミスを修正
shopt -s dirspell        # 補完時のディレクトリ名タイプミスを修正
shopt -s direxpand       # Tab補完で変数を展開

# グロブ
shopt -s globstar        # ** で再帰マッチ
shopt -s nocaseglob      # 大文字小文字を無視
shopt -s dotglob         # * でドットファイルもマッチ
shopt -s extglob         # !(pattern) 等の拡張グロブ

# その他
shopt -s checkwinsize    # ウィンドウサイズを更新
shopt -s expand_aliases  # エイリアスを展開
shopt -s no_empty_cmd_completion  # 空行Tab補完防止

# ============================================================================
# 補完
# ============================================================================

# bash-completion
if [[ -f /usr/share/bash-completion/bash_completion ]]; then
    source /usr/share/bash-completion/bash_completion
elif [[ -f /etc/bash_completion ]]; then
    source /etc/bash_completion
elif [[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]]; then
    source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
fi

# Git 補完
if [[ -f "$HOME/.git-completion.bash" ]]; then
    source "$HOME/.git-completion.bash"
elif [[ -f "$DOTFILES_DIR/.git-completion.bash" ]]; then
    source "$DOTFILES_DIR/.git-completion.bash"
fi

if [[ -f "$HOME/.git-prompt.sh" ]]; then
    source "$HOME/.git-prompt.sh"
elif [[ -f "$DOTFILES_DIR/.git-prompt.sh" ]]; then
    source "$DOTFILES_DIR/.git-prompt.sh"
fi

# readline 補完強化
bind 'set show-all-if-ambiguous on'         # 1回Tab で候補表示
bind 'set completion-ignore-case on'        # 大文字小文字無視
bind 'set mark-symlinked-directories on'    # symlink に / 付与
bind 'set colored-stats on'                 # 補完候補に色

# ============================================================================
# プロンプト
# ============================================================================

# oh-my-posh (インストールされていれば使用)
_setup_oh_my_posh() {
    if ! command -v oh-my-posh &>/dev/null; then
        return 1
    fi

    local theme="${OH_MY_POSH_THEME:-sim-web.omp.json}"
    local config=""

    # テーマファイルの検索
    for dir in "$HOME/.poshthemes" "$DOTFILES_DIR/poshthemes" "/usr/share/oh-my-posh/themes"; do
        if [[ -f "$dir/$theme" ]]; then
            config="$dir/$theme"
            break
        fi
    done

    if [[ -z "$config" ]]; then
        return 1
    fi

    # キャッシュディレクトリ
    local cache_dir="$HOME/.cache/oh-my-posh"
    mkdir -p "$cache_dir"

    # 初期化
    if ! eval "$(oh-my-posh init bash --config "$config")" 2>/dev/null; then
        rm -rf "$cache_dir"
        mkdir -p "$cache_dir"
        if ! eval "$(oh-my-posh init bash --config "$config")" 2>/dev/null; then
            return 1
        fi
    fi

    return 0
}

# カスタムGitプロンプト関数
__custom_git_prompt() {
    # Gitリポジトリ内かチェック
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        return
    fi

    local branch
    branch=$(git branch --show-current 2>/dev/null)
    [[ -z "$branch" ]] && branch=$(git rev-parse --short HEAD 2>/dev/null)
    [[ -z "$branch" ]] && return

    local indicators=""

    # 変更チェック(*, 赤Bold)
    if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
        indicators+="\001\033[1;31m\002*\001\033[0m\002"
    fi

    # リモートとの差分チェック
    local upstream
    upstream=$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)
    if [[ -n "$upstream" ]]; then
        local ahead behind
        ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null)
        behind=$(git rev-list --count 'HEAD..@{upstream}' 2>/dev/null)

        # push必要(↑, ライトブルー)
        if [[ "$ahead" -gt 0 ]]; then
            indicators+="\001\033[1;96m\002↑\001\033[0m\002"
        fi
        # pull必要(↓, ライトブルー)
        if [[ "$behind" -gt 0 ]]; then
            indicators+="\001\033[1;96m\002↓\001\033[0m\002"
        fi
    fi

    # ブランチ名は赤Bold
    echo -e " (\001\033[1;31m\002${branch}\001\033[0m\002${indicators})"
}

# oh-my-posh を試行、失敗したらシンプルなプロンプト
# Git for Windows環境では ~/.config/git/.git-prompt.sh が使われるのでスキップ
if [[ -z "$MSYSTEM" ]] && ! _setup_oh_my_posh; then
    # Git ブランチ付きのシンプルなプロンプト
    if declare -f __git_ps1 &>/dev/null; then
        GIT_PS1_SHOWDIRTYSTATE=1
        GIT_PS1_SHOWSTASHSTATE=1
        GIT_PS1_SHOWUNTRACKEDFILES=1
        GIT_PS1_SHOWUPSTREAM="auto"
        GIT_PS1_SHOWCONFLICTSTATE="yes"
        # 形式: user@host:path (branch)\n$ (青Bold、rootは赤Bold #)
        if [[ "$(id -u)" -eq 0 ]]; then
            PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(__git_ps1 " (%s)")\[\033[00m\]\n\[\033[01;31m\]#\[\033[00m\] '
        else
            PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(__git_ps1 " (%s)")\[\033[00m\]\n\[\033[01;34m\]$\[\033[00m\] '
        fi
    else
        if [[ "$(id -u)" -eq 0 ]]; then
            PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\n\[\033[01;31m\]#\[\033[00m\] '
        else
            PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\n\[\033[01;34m\]$\[\033[00m\] '
        fi
    fi
fi

unset -f _setup_oh_my_posh

# ============================================================================
# bash固有エイリアス
# ============================================================================

# ヒストリ再読み込み
alias hr='history -r'

# 直前のコマンドを sudo で再実行
alias please='sudo $(fc -ln -1)'

# ============================================================================
# bash固有関数
# ============================================================================

# ディレクトリ作成して移動
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# ディレクトリスタック操作
pd() { pushd "$@" >/dev/null && dirs -v; }
pp() { popd >/dev/null && dirs -v; }

# ============================================================================
# ローカル設定 (bash固有、Git管理外)
# ============================================================================

if [[ -f "$HOME/.bashrc.local" ]]; then
    source "$HOME/.bashrc.local"
fi

# Homebrew (Linux/WSL環境のみ)
if [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# mise (ランタイムバージョン管理)
if command -v mise &>/dev/null; then
    eval "$(mise activate bash)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
    eval "$("${HOME}/.local/bin/mise" activate bash)"
fi

# ============================================================================
# モダンツール (fzf, zoxide)
# ============================================================================

# fzf: Ctrl+R 履歴検索, Ctrl+T ファイル検索
if command -v fzf &>/dev/null; then
    eval "$(fzf --bash 2>/dev/null)"
fi

# zoxide: スマート cd (z コマンド)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

# ============================================================================
# ClaudeCode
# ============================================================================

# WSL/Git Bash: Claude Code powershell.exe 回避
# ref: https://github.com/anthropics/claude-code/issues/14352
case "${DOTFILES_PLATFORM:-}" in
    wsl|windows)
        export CLAUDE_CODE_SKIP_WINDOWS_PROFILE=1
        ;;
esac


