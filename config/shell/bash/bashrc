#!/bin/bash
# config/shell/bash/bashrc - bash固有設定
#
# 配置先: ~/.bashrc (シンボリックリンク)
# 読み込み: 対話シェル起動時

# ============================================================================
# 非対話シェルは即終了
# ============================================================================

case $- in
    *i*) ;;
    *) return ;;
esac

# ============================================================================
# SSH Agent 自動起動
# ============================================================================

_setup_ssh_agent() {
    local ssh_env="$HOME/.ssh/agent.env"

    # 既存のagentに接続を試みる
    if [[ -f "$ssh_env" ]]; then
        source "$ssh_env" >/dev/null
        # agentプロセスが生きているか確認
        if ! kill -0 "$SSH_AGENT_PID" 2>/dev/null; then
            # プロセスが死んでいるので再起動
            rm -f "$ssh_env"
            unset SSH_AUTH_SOCK SSH_AGENT_PID
        fi
    fi

    # agentが起動していなければ新規起動
    if [[ -z "$SSH_AUTH_SOCK" ]] || [[ ! -S "$SSH_AUTH_SOCK" ]]; then
        ssh-agent -s > "$ssh_env"
        chmod 600 "$ssh_env"
        source "$ssh_env" >/dev/null
    fi

    # 鍵が登録されていなければ追加
    if ! ssh-add -l &>/dev/null; then
        for key in "$HOME"/.ssh/id_*; do
            # 公開鍵(.pub)はスキップ
            [[ "$key" == *.pub ]] && continue
            # ファイルが存在すれば追加
            [[ -f "$key" ]] && ssh-add "$key" 2>/dev/null
        done
    fi
}

_setup_ssh_agent
unset -f _setup_ssh_agent

# ============================================================================
# 共通設定の読み込み
# ============================================================================

# DOTFILES_DIR を検出 (config/shell/bash/ -> dotfiles root)
_bashrc_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$(dirname "$(dirname "$(dirname "$_bashrc_dir")")")}"
unset _bashrc_dir

# 共通設定を読み込み
if [[ -f "$DOTFILES_DIR/config/shell/common.sh" ]]; then
    source "$DOTFILES_DIR/config/shell/common.sh"
fi

# ============================================================================
# bash オプション
# ============================================================================

# ヒストリ設定
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S "

shopt -s histappend      # ヒストリを追記
shopt -s cmdhist         # 複数行コマンドを1行で保存

# ディレクトリ
shopt -s autocd          # ディレクトリ名だけで cd
shopt -s cdspell         # cd のタイプミスを修正
shopt -s dirspell        # 補完時のディレクトリ名タイプミスを修正

# グロブ
shopt -s globstar        # ** で再帰マッチ
shopt -s nocaseglob      # 大文字小文字を無視

# その他
shopt -s checkwinsize    # ウィンドウサイズを更新
shopt -s expand_aliases  # エイリアスを展開

# ============================================================================
# 補完
# ============================================================================

# bash-completion
if [[ -f /usr/share/bash-completion/bash_completion ]]; then
    source /usr/share/bash-completion/bash_completion
elif [[ -f /etc/bash_completion ]]; then
    source /etc/bash_completion
elif [[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]]; then
    source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
fi

# Git 補完
if [[ -f "$HOME/.git-completion.bash" ]]; then
    source "$HOME/.git-completion.bash"
elif [[ -f "$DOTFILES_DIR/.git-completion.bash" ]]; then
    source "$DOTFILES_DIR/.git-completion.bash"
fi

# ============================================================================
# プロンプト
# ============================================================================

# Git ブランチ表示用
if [[ -f "$HOME/.git-prompt.sh" ]]; then
    source "$HOME/.git-prompt.sh"
elif [[ -f "$DOTFILES_DIR/.git-prompt.sh" ]]; then
    source "$DOTFILES_DIR/.git-prompt.sh"
fi

# oh-my-posh (インストールされていれば使用)
_setup_oh_my_posh() {
    if ! command -v oh-my-posh &>/dev/null; then
        return 1
    fi
    
    local theme="${OH_MY_POSH_THEME:-sim-web.omp.json}"
    local config=""
    
    # テーマファイルの検索
    for dir in "$HOME/.poshthemes" "$DOTFILES_DIR/poshthemes" "/usr/share/oh-my-posh/themes"; do
        if [[ -f "$dir/$theme" ]]; then
            config="$dir/$theme"
            break
        fi
    done
    
    if [[ -z "$config" ]]; then
        return 1
    fi
    
    # キャッシュディレクトリ
    local cache_dir="$HOME/.cache/oh-my-posh"
    mkdir -p "$cache_dir"
    
    # 初期化
    if ! eval "$(oh-my-posh init bash --config "$config")" 2>/dev/null; then
        rm -rf "$cache_dir"
        mkdir -p "$cache_dir"
        eval "$(oh-my-posh init bash --config "$config")"
    fi
    
    return 0
}

# oh-my-posh を試行、失敗したらシンプルなプロンプト
if ! _setup_oh_my_posh; then
    # Git ブランチ付きのシンプルなプロンプト
    if declare -f __git_ps1 &>/dev/null; then
        GIT_PS1_SHOWDIRTYSTATE=1
        GIT_PS1_SHOWSTASHSTATE=1
        GIT_PS1_SHOWUNTRACKEDFILES=1
        PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(__git_ps1 " (%s)")\[\033[00m\]\$ '
    else
        PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
    fi
fi

unset -f _setup_oh_my_posh

# ============================================================================
# bash固有エイリアス
# ============================================================================

# ヒストリ再読み込み
alias hr='history -r'

# 直前のコマンドを sudo で再実行
alias please='sudo $(fc -ln -1)'

# ============================================================================
# bash固有関数
# ============================================================================

# ディレクトリ作成して移動
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# ディレクトリスタック操作
pd() { pushd "$@" >/dev/null && dirs -v; }
pp() { popd >/dev/null && dirs -v; }

# ============================================================================
# ローカル設定 (bash固有、Git管理外)
# ============================================================================

if [[ -f "$HOME/.bashrc.local" ]]; then
    source "$HOME/.bashrc.local"
fi

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
