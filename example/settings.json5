{
  // Claude Code グローバル設定
  // ~/.claude/settings.json

  // ============================================
  // 🚨 Output最適化 (最優先)
  // ============================================
  "output": {
    "maxTokens": 2000,
    "format": "table-preferred",
    "noPreamble": true,
    "noPostamble": true,
    "useSymbols": true
  },

  // ============================================
  // 📋 Skills設定
  // ============================================
  "skills": {
    // 階層構造
    "hierarchy": "4-tier",
    
    // 常時適用 (Core)
    "core": [
      "systematic-debugging",
      "test-driven-development",
      "code-review",
      "git-workflow",
      "problem-solving",
      "quality-automation",
      "output-optimization",
      "hallucination-prevention",
      "communication-guidelines",
      "forbidden-actions"
    ],
    
    // 自動検出による適用
    "autoDetect": true,
    
    // 最大読み込み数
    "maxLoad": 20
  },

  // ============================================
  // 🔧 Context Loading
  // ============================================
  "context": {
    // Incremental Loading
    "mode": "incremental",
    
    // 初期読み込みファイル
    "initial": [
      "CLAUDE.md",
      "README.md",
      "package.json"
    ],
    
    // 自動展開最大数
    "autoExpandMax": 3,
    
    // 除外パターン (.claudeignoreと併用)
    "exclude": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      "*.log"
    ]
  },

  // ============================================
  // 🎯 Commands
  // ============================================
  "commands": {
    // 有効化
    "enabled": true,
    
    // カスタムCommandsディレクトリ
    "customPaths": [
      "~/.claude/commands",
      "./.claude/commands"
    ],
    
    // エイリアス
    "aliases": {
      "/r": "/research",
      "/b": "/bounce",
      "/i": "/implement",
      "/c": "/commit",
      "/rv": "/review"
    }
  },

  // ============================================
  // 🔗 Hooks
  // ============================================
  "hooks": {
    // 有効化
    "enabled": true,
    
    // 自動実行
    "autoRun": [
      "session-start-reminder",
      "destructive-command-block"
    ],
    
    // 失敗時の動作
    "onFailure": "warn"
  },

  // ============================================
  // 📐 Development Settings
  // ============================================
  "development": {
    // Test-First Mode
    "testFirst": false,
    
    // Diff Preview
    "diffPreview": true,
    
    // Auto Save
    "autoSave": false,
    
    // Backup on Edit
    "backupOnEdit": false
  },

  // ============================================
  // 📦 Import Management
  // ============================================
  "imports": {
    // 自動import追加
    "autoImport": true,
    
    // import自動ソート
    "sortImports": true,
    
    // 未使用import削除
    "removeUnused": true,
    
    // import style
    "style": "absolute"
  },

  // ============================================
  // 🔍 Symbol Navigation
  // ============================================
  "symbols": {
    // 有効化
    "enabled": true,
    
    // インデックス自動生成
    "autoIndex": true,
    
    // キャッシュ有効期限 (秒)
    "cacheTTL": 3600
  },

  // ============================================
  // 💾 Session
  // ============================================
  "session": {
    // Session永続化
    "persistence": true,
    
    // 自動保存間隔 (秒)
    "autoSaveInterval": 300,
    
    // Session保存先
    "savePath": "~/.claude/sessions"
  },

  // ============================================
  // 🎨 UI/UX
  // ============================================
  "ui": {
    // プログレス表示
    "showProgress": true,
    
    // 詳細ログ
    "verbose": false,
    
    // カラー出力
    "colorOutput": true,
    
    // 通知
    "notifications": true
  },

  // ============================================
  // 🌍 Language
  // ============================================
  "language": {
    // デフォルト言語
    "default": "ja",
    
    // コードコメント言語
    "codeComments": "en",
    
    // ドキュメント言語
    "documentation": "ja"
  },

  // ============================================
  // 🔐 Security
  // ============================================
  "security": {
    // Git操作ブロック
    "blockGitCommit": true,
    "blockGitPush": true,
    
    // mainブランチ保護
    "protectMainBranch": true,
    
    // 機密情報検出
    "detectSecrets": true,
    
    // 許可されたドメイン
    "allowedDomains": []
  },

  // ============================================
  // 📊 Performance
  // ============================================
  "performance": {
    // 並列処理
    "parallel": true,
    
    // 最大並列数
    "maxParallel": 4,
    
    // キャッシュ有効化
    "cacheEnabled": true,
    
    // メモリ制限 (MB)
    "memoryLimit": 512
  },

  // ============================================
  // 🐛 Debug
  // ============================================
  "debug": {
    // デバッグモード
    "enabled": false,
    
    // ログレベル (error/warn/info/debug)
    "logLevel": "info",
    
    // ログ出力先
    "logPath": "~/.claude/logs/claude.log"
  },

  // ============================================
  // 🔄 Updates
  // ============================================
  "updates": {
    // 自動更新チェック
    "autoCheck": true,
    
    // チェック間隔 (時間)
    "checkInterval": 24,
    
    // 自動適用
    "autoApply": false
  },

  // ============================================
  // 🎯 Project Defaults
  // ============================================
  "projectDefaults": {
    // プロジェクト検出
    "autoDetect": true,
    
    // デフォルトSkills (プロジェクト未設定時)
    "defaultSkills": [
      "2-domain/devops/ci-cd"
    ],
    
    // デフォルトファイル作成
    "createDefaults": true,
    
    // 作成するファイル
    "defaultFiles": [
      ".claudeignore",
      "CLAUDE.md"
    ]
  },

  // ============================================
  // 📈 Analytics
  // ============================================
  "analytics": {
    // 使用統計収集
    "enabled": false,
    
    // 匿名化
    "anonymous": true,
    
    // レポート生成
    "generateReports": false
  },

  // ============================================
  // 🎓 Custom
  // ============================================
  "custom": {
    // プロジェクト固有設定はここに追加
    // 例:
    // "myCustomSetting": "value"
  }
}
