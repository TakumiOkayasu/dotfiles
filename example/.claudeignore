# .claudeignore - Claude Code 除外ファイル設定
# トークン削減: ▼80-95%

# ============================================
# 📦 Dependencies (必須)
# ============================================

# Node.js
node_modules/
bower_components/
jspm_packages/

# Python
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/
build/

# PHP
vendor/
composer.phar

# Ruby
.bundle/
vendor/bundle/

# Go
vendor/

# Rust
target/
Cargo.lock

# ============================================
# 🔨 Build Outputs (必須)
# ============================================

# General
dist/
build/
out/
output/
*.min.js
*.min.css

# JavaScript/TypeScript
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
.turbo/

# Python
*.pyc
*.pyo
*.pyd
.eggs/
*.egg

# C/C++
*.o
*.obj
*.a
*.so
*.dylib
*.lib
*.dll
*.exe
*.out

# Java
*.class
*.jar
*.war
*.ear
target/

# .NET
bin/
obj/
*.dll
*.exe
*.pdb

# ============================================
# 🔐 Version Control (必須)
# ============================================

.git/
.svn/
.hg/
.bzr/
.gitignore
.gitattributes

# ============================================
# 🖥️ IDE / Editor (推奨)
# ============================================

# VSCode
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# 📝 Logs (必須)
# ============================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# 🧪 Test Coverage (推奨)
# ============================================

coverage/
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/
.hypothesis/
*.cover
.nyc_output/
lcov.info

# ============================================
# 🔧 Environment (必須)
# ============================================

.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.secret
*.key
.secrets/

# ============================================
# 🖼️ OS (推奨)
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============================================
# 📱 Mobile (該当時)
# ============================================

# iOS
Pods/
*.xcworkspace
*.xcuserdata/

# Android
.gradle/
local.properties
*.apk
*.aab

# React Native
android/app/build/
ios/Pods/

# ============================================
# ⚡ Embedded / IoT (該当時)
# ============================================

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Arduino
*.hex
*.bin
*.elf

# ESP32/ESP8266
.esphome/

# ============================================
# 🗄️ Database (該当時)
# ============================================

*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ============================================
# 🎨 Assets (サイズ大)
# ============================================

# Images (オリジナルのみ除外)
# *.png
# *.jpg
# *.jpeg
# *.gif
# *.bmp

# Videos
*.mp4
*.avi
*.mov
*.wmv

# Audio
*.mp3
*.wav
*.flac

# Fonts (生成物のみ)
# *.woff
# *.woff2
# *.ttf
# *.eot

# ============================================
# 📚 Documentation (大量の場合)
# ============================================

# Generated docs
docs/_build/
site/
_site/

# ============================================
# 🔄 Temporary (推奨)
# ============================================

tmp/
temp/
*.tmp
*.temp
*.cache
.cache/

# ============================================
# 🚀 Deployment (推奨)
# ============================================

.vercel/
.netlify/
.firebase/

# ============================================
# 📊 Analytics (該当時)
# ============================================

.lighthouseci/

# ============================================
# 🎯 Custom (プロジェクト固有)
# ============================================

# Add your project-specific ignores here
# Example:
# my-large-dataset/
# generated-code/
