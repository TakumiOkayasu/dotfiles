#!/bin/bash
#
# git-cleanup-branch - マージ済みブランチを削除するスクリプト
#
# 使い方:
#   git-cleanup-branch           # 現在のブランチを削除
#   git-cleanup-branch feat/foo  # 指定したブランチを削除
#
# 機能:
#   - main ブランチに移動
#   - 指定したブランチをローカル・リモート両方から削除
#   - マージされていないブランチは削除しない (安全)
#   - 対応する .claude/notes/{task-id}.md を .claude/notes/archive/ へ移動
#     (session-memory.md「File-System Memory」規約)

set -euo pipefail

# 色定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# スカッシュマージ判定: ブランチの全変更が HEAD に含まれているか
is_squash_merged() {
    local base_branch="$1" branch="$2"
    local merge_base
    merge_base=$(git merge-base "$base_branch" "$branch" 2>/dev/null) || return 1
    # ブランチのツリーを merge_base の子として仮コミット化し、cherry で default ブランチと比較
    local squash_commit
    squash_commit=$(git commit-tree "${branch}^{tree}" -p "$merge_base" -m "tmp" 2>/dev/null) || return 1
    local unmerged
    unmerged=$(git cherry "$base_branch" "$squash_commit" "$merge_base" 2>/dev/null | grep '^\+' || true)
    [[ -z "$unmerged" ]]
}

# notes ファイルをアーカイブ
# session-memory.md「File-System Memory」規約に基づき、削除済みブランチに対応する
# .claude/notes/{task-id}.md を .claude/notes/archive/ へ移動する
archive_notes_for_branch() {
    local branch="$1"
    local task_id="${branch//\//-}"
    local notes_file=".claude/notes/${task_id}.md"

    if [[ -f "$notes_file" ]]; then
        mkdir -p .claude/notes/archive
        mv "$notes_file" ".claude/notes/archive/${task_id}.md"
        echo -e "${GREEN}✓ notes アーカイブ: ${notes_file} → .claude/notes/archive/${task_id}.md${NC}"
    fi
}

# メイン関数
main() {
    local branch_to_delete="${1:-}"
    local current_branch
    local main_branch main_ref

    # Git リポジトリ内か確認
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo -e "${RED}エラー: Git リポジトリ内で実行してください${NC}" >&2
        exit 1
    fi

    # メインブランチを取得
    main_branch=$(git config --local --get claude.mainBranch 2>/dev/null || echo "")
    if [[ -z "$main_branch" ]]; then
        # デフォルトブランチを検出
        main_branch=$(git remote show origin 2>/dev/null | grep 'HEAD branch' | awk '{print $NF}' || true)
        if [[ -z "$main_branch" ]]; then
            main_branch="main"
        fi
    fi

    # 現在のブランチを取得
    current_branch=$(git branch --show-current)

    # 削除対象ブランチを決定
    if [[ -z "$branch_to_delete" ]]; then
        branch_to_delete="$current_branch"
    fi

    # メインブランチは削除禁止
    if [[ "$branch_to_delete" == "$main_branch" ]]; then
        echo -e "${RED}エラー: メインブランチ (${main_branch}) は削除できません${NC}" >&2
        exit 1
    fi

    main_ref="refs/heads/${main_branch}"
    if ! git rev-parse --verify --quiet "${main_ref}^{commit}" >/dev/null; then
        echo -e "${RED}エラー: メインブランチ (${main_branch}) を確認できません${NC}" >&2
        exit 1
    fi

    echo -e "${BLUE}削除対象ブランチ: ${branch_to_delete}${NC}"
    echo -e "${BLUE}メインブランチ: ${main_branch}${NC}"
    echo ""

    # 確認プロンプト
    read -rp "このブランチを削除しますか? (ローカル・リモート両方) [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}キャンセルしました${NC}"
        exit 0
    fi

    # メインブランチに移動
    if [[ "$current_branch" == "$branch_to_delete" ]]; then
        echo -e "${BLUE}${main_branch} に移動中...${NC}"
        git checkout "$main_branch"
        if git remote get-url origin &>/dev/null; then
            if ! git pull --ff-only origin "$main_branch"; then
                echo -e "${YELLOW}! pull に失敗しました（ネットワーク等を確認してください）${NC}"
            fi
        else
            echo -e "${YELLOW}! リモート (origin) が未設定のため pull をスキップしました${NC}"
        fi
    fi

    # ローカルブランチを削除
    echo -e "${BLUE}ローカルブランチを削除中...${NC}"
    local local_deleted=false
    if git merge-base --is-ancestor "$branch_to_delete" "$main_ref" 2>/dev/null; then
        # 通常マージ: ブランチが default ブランチの祖先
        if git branch -D "$branch_to_delete"; then
            echo -e "${GREEN}✓ ローカルブランチを削除しました (マージ済み)${NC}"
            local_deleted=true
        else
            echo -e "${YELLOW}! ローカルブランチを削除できませんでした${NC}"
        fi
    elif is_squash_merged "$main_ref" "$branch_to_delete"; then
        if git branch -D "$branch_to_delete"; then
            echo -e "${GREEN}✓ ローカルブランチを削除しました (スカッシュマージ済み)${NC}"
            local_deleted=true
        else
            echo -e "${YELLOW}! ローカルブランチを削除できませんでした${NC}"
        fi
    else
        echo -e "${YELLOW}! ブランチはまだマージされていません${NC}"
        read -rp "強制削除しますか? [y/N]: " force_confirm
        if [[ "$force_confirm" =~ ^[Yy]$ ]]; then
            if git branch -D "$branch_to_delete"; then
                echo -e "${GREEN}✓ ローカルブランチを強制削除しました${NC}"
                local_deleted=true
            else
                echo -e "${YELLOW}! ローカルブランチを削除できませんでした${NC}"
            fi
        fi
    fi

    # notes アーカイブ (session-memory.md 規約)
    if [[ "$local_deleted" == "true" ]]; then
        archive_notes_for_branch "$branch_to_delete"
    else
        echo -e "${YELLOW}! ローカル削除が完了していないためリモートブランチを削除しません${NC}"
        exit 1
    fi

    # リモートブランチを削除
    echo -e "${BLUE}リモートブランチを削除中...${NC}"
    if ! git remote get-url origin &>/dev/null; then
        echo -e "${YELLOW}! リモート (origin) が未設定のためリモートブランチの削除をスキップしました${NC}"
    elif git push origin --delete "$branch_to_delete" 2>/dev/null; then
        echo -e "${GREEN}✓ リモートブランチを削除しました${NC}"
    else
        echo -e "${YELLOW}! リモートブランチが存在しないか、削除に失敗しました${NC}"
    fi

    echo ""
    echo -e "${GREEN}完了しました${NC}"
}

main "$@"

