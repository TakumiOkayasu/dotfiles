#!/bin/bash
#
# claude-init - Claude Code project template initializer
# Usage: claude-init <lang> [options]
#

set -euo pipefail

# Constants
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
TEMPLATES_DIR="$DOTFILES_DIR/claude/templates"
BASE_DIR="$TEMPLATES_DIR/base"
LANG_DIR="$TEMPLATES_DIR/lang"
RULES_DIR="$TEMPLATES_DIR/rules"

# Available languages
AVAILABLE_LANGS=("python" "typescript" "cpp" "php-cakephp" "php-laravel" "go")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Show help
show_help() {
    cat << EOF
claude-init - Claude Code project template initializer

Usage:
    claude-init <lang>           Initialize project with specified language template
    claude-init --list           List available language templates
    claude-init --help           Show this help message

Available languages:
    python        Python project (pytest, ruff/black)
    typescript    TypeScript project (vitest/jest, prettier/eslint)
    cpp           C++ project (Google Test/Catch2, C++17+)
    php-cakephp   PHP CakePHP project (PHPUnit)
    php-laravel   PHP Laravel project (PHPUnit)
    go            Go project (testing package, gofmt)

Options:
    --force       Overwrite existing files without confirmation
    --dry-run     Show what would be created without actually creating

Examples:
    claude-init python           # Initialize Python project
    claude-init typescript       # Initialize TypeScript project
    claude-init --list           # Show available templates
    claude-init python --dry-run # Preview what would be created

EOF
}

# List available languages
list_languages() {
    echo "Available language templates:"
    echo ""
    for lang in "${AVAILABLE_LANGS[@]}"; do
        if [ -f "$LANG_DIR/$lang.md" ]; then
            echo "  - $lang"
        else
            echo "  - $lang (template not found)"
        fi
    done
    echo ""
    echo "Usage: claude-init <lang>"
}

# Check if language is valid
is_valid_lang() {
    local lang="$1"
    for valid_lang in "${AVAILABLE_LANGS[@]}"; do
        if [ "$lang" = "$valid_lang" ]; then
            return 0
        fi
    done
    return 1
}

# Confirm overwrite
confirm_overwrite() {
    local file="$1"
    if [ "$FORCE" = true ]; then
        return 0
    fi

    echo -n "File '$file' already exists. Overwrite? [y/N] "
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY])
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Copy file with confirmation
copy_file() {
    local src="$1"
    local dest="$2"
    local dest_dir
    dest_dir="$(dirname "$dest")"

    if [ "$DRY_RUN" = true ]; then
        if [ -f "$dest" ]; then
            print_info "[DRY-RUN] Would overwrite: $dest"
        else
            print_info "[DRY-RUN] Would create: $dest"
        fi
        return 0
    fi

    # Create destination directory if needed
    if [ ! -d "$dest_dir" ]; then
        mkdir -p "$dest_dir"
    fi

    # Check if file exists
    if [ -f "$dest" ]; then
        if confirm_overwrite "$dest"; then
            cp "$src" "$dest"
            print_success "Overwritten: $dest"
        else
            print_warning "Skipped: $dest"
        fi
    else
        cp "$src" "$dest"
        print_success "Created: $dest"
    fi
}

# Copy directory recursively
copy_directory() {
    local src_dir="$1"
    local dest_dir="$2"

    if [ ! -d "$src_dir" ]; then
        print_error "Source directory not found: $src_dir"
        return 1
    fi

    find "$src_dir" -type f | while read -r src_file; do
        local relative_path="${src_file#$src_dir/}"
        local dest_file="$dest_dir/$relative_path"
        copy_file "$src_file" "$dest_file"
    done
}

# Main initialization function
init_project() {
    local lang="$1"
    local project_dir
    project_dir="$(pwd)"

    print_info "Initializing Claude Code template for: $lang"
    print_info "Project directory: $project_dir"
    echo ""

    # Check if templates exist
    if [ ! -f "$LANG_DIR/$lang.md" ]; then
        print_error "Language template not found: $LANG_DIR/$lang.md"
        exit 1
    fi

    # Copy base commands
    if [ -d "$BASE_DIR/commands" ]; then
        print_info "Copying commands..."
        copy_directory "$BASE_DIR/commands" "$project_dir/.claude/commands"
    fi

    # Copy base tasks template
    if [ -d "$BASE_DIR/tasks" ]; then
        print_info "Copying tasks template..."
        copy_directory "$BASE_DIR/tasks" "$project_dir/.claude/tasks"
    fi

    # Copy common rules
    if [ -d "$RULES_DIR/common" ]; then
        print_info "Copying common rules..."
        copy_directory "$RULES_DIR/common" "$project_dir/.claude/rules"
    fi

    # Copy language-specific rules
    if [ -d "$RULES_DIR/$lang" ]; then
        print_info "Copying $lang rules..."
        copy_directory "$RULES_DIR/$lang" "$project_dir/.claude/rules"
    fi

    # Copy language-specific CLAUDE.md
    print_info "Copying CLAUDE.md..."
    copy_file "$LANG_DIR/$lang.md" "$project_dir/CLAUDE.md"

    echo ""
    if [ "$DRY_RUN" = true ]; then
        print_info "Dry run completed. No files were created."
    else
        print_success "Claude Code template initialized successfully!"
        echo ""
        echo "Next steps:"
        echo "  1. Review and customize CLAUDE.md for your project"
        echo "  2. Review .claude/rules/ and adjust for your project"
        echo "  3. Use /commit, /code-review, /implement commands"
    fi
}

# Parse arguments
FORCE=false
DRY_RUN=false
LANG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --list|-l)
            list_languages
            exit 0
            ;;
        --force|-f)
            FORCE=true
            shift
            ;;
        --dry-run|-n)
            DRY_RUN=true
            shift
            ;;
        -*)
            print_error "Unknown option: $1"
            echo "Use --help for usage information."
            exit 1
            ;;
        *)
            if [ -z "$LANG" ]; then
                LANG="$1"
            else
                print_error "Too many arguments: $1"
                exit 1
            fi
            shift
            ;;
    esac
done

# Main execution
if [ -z "$LANG" ]; then
    print_error "Language not specified."
    echo ""
    show_help
    exit 1
fi

if ! is_valid_lang "$LANG"; then
    print_error "Invalid language: $LANG"
    echo ""
    list_languages
    exit 1
fi

init_project "$LANG"
