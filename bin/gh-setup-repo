#!/bin/bash
#
# gh-setup-repo - GitHubリポジトリの初期設定を行うスクリプト
#
# 設定内容:
#   - PRマージ後のブランチ自動削除を有効化
#   - defaultブランチの保護 (直接pushを禁止)

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat <<EOF
使い方: gh-setup-repo [オプション] [owner/repo]

オプション:
  --check       現在の設定を確認するのみ
  -h, --help    このヘルプを表示

設定内容:
  - PRマージ後のブランチ自動削除 (delete_branch_on_merge)
  - defaultブランチの保護 (直接pushを禁止、PR必須)

例:
  gh-setup-repo                    # 現在のリポジトリ
  gh-setup-repo owner/repo         # 指定リポジトリ
  gh-setup-repo --check            # 設定確認のみ
EOF
}

get_repo_name() {
    if [[ -n "${1:-}" && "$1" != --* ]]; then
        printf '%s\n' "$1"
    else
        gh repo view --json nameWithOwner -q '.nameWithOwner' 2>/dev/null || {
            echo -e "${RED}エラー: リポジトリを特定できません${NC}" >&2
            return 1
        }
    fi
}

get_default_branch() {
    local repo="$1" default_branch
    if ! default_branch=$(gh api "repos/${repo}" --jq '.default_branch' 2>/dev/null); then
        echo -e "${RED}エラー: defaultブランチを取得できません${NC}" >&2
        return 1
    fi
    if [[ -z "$default_branch" || "$default_branch" == "null" ]]; then
        echo -e "${RED}エラー: defaultブランチが未設定です${NC}" >&2
        return 1
    fi
    printf '%s\n' "$default_branch"
}

branch_protection_path() {
    local repo="$1" branch="$2" encoded_branch
    encoded_branch=$(jq -rn --arg value "$branch" '$value | @uri')
    printf 'repos/%s/branches/%s/protection\n' "$repo" "$encoded_branch"
}

# 0: existing protection, 2: explicitly unprotected, 1: unable to read.
get_branch_protection() {
    local repo="$1" branch="$2" path result
    path=$(branch_protection_path "$repo" "$branch")
    if result=$(gh api "$path" 2>&1); then
        printf '%s\n' "$result"
        return 0
    fi
    if grep -Fq 'Branch not protected (HTTP 404)' <<<"$result"; then
        return 2
    fi
    printf '%s\n' "$result" >&2
    return 1
}

default_protection_payload() {
    cat <<'EOF'
{
  "required_status_checks": null,
  "enforce_admins": false,
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": false,
    "require_code_owner_reviews": false,
    "required_approving_review_count": 0,
    "require_last_push_approval": false
  },
  "restrictions": null,
  "required_linear_history": false,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": false,
  "lock_branch": false,
  "allow_fork_syncing": false
}
EOF
}

# Update branch protection is a whole-resource PUT. Keep every documented,
# writable setting from the GET response, and reject settings that this endpoint
# cannot represent instead of silently weakening them.
existing_protection_payload() {
    jq -ce '
      def reject_unknown($allowed):
        (keys - $allowed) as $unknown |
        if ($unknown | length) == 0 then .
        else error("unsupported branch protection fields: " + ($unknown | join(", "))) end;
      def access_list:
        if . == null then null else
          reject_unknown(["url", "users_url", "teams_url", "apps_url", "users", "teams", "apps"]) |
          {users: [.users[]?.login], teams: [.teams[]?.slug], apps: [.apps[]?.slug]}
        end;
      def status_checks:
        if . == null then null else
          reject_unknown(["url", "contexts_url", "strict", "contexts", "checks", "enforcement_level"]) |
          if has("strict") then . else error("required_status_checks.strict is missing") end |
          if (.checks? != null and ([.checks[] | (keys - ["context", "app_id"] | length > 0)] | any))
          then error("unsupported required status check fields") else . end |
          {strict: .strict, contexts: (.contexts // []), checks: .checks} |
          with_entries(select(.value != null))
        end;
      def pull_request_reviews:
        if . == null then null else
          reject_unknown([
            "url", "dismissal_restrictions", "dismiss_stale_reviews",
            "require_code_owner_reviews", "required_approving_review_count",
            "require_last_push_approval", "bypass_pull_request_allowances"
          ]) |
          {
            dismissal_restrictions: (.dismissal_restrictions | access_list),
            dismiss_stale_reviews: .dismiss_stale_reviews,
            require_code_owner_reviews: .require_code_owner_reviews,
            required_approving_review_count: .required_approving_review_count,
            require_last_push_approval: .require_last_push_approval,
            bypass_pull_request_allowances: (.bypass_pull_request_allowances | access_list)
          } |
          with_entries(select(.value != null))
        end;
      def enabled($name; $default):
        if has($name) and .[$name] != null
        then .[$name] | reject_unknown(["url", "enabled"]) | .enabled
        else $default end;
      def signature_protection:
        if .required_signatures == null then .
        else (.required_signatures | reject_unknown(["url", "enabled"])) as $signature | .
        end;

      reject_unknown([
        "url", "required_status_checks", "enforce_admins",
        "required_pull_request_reviews", "restrictions", "required_signatures",
        "required_linear_history", "allow_force_pushes", "allow_deletions",
        "block_creations", "required_conversation_resolution", "lock_branch",
        "allow_fork_syncing"
      ]) |
      # required_signatures has its own documented GET/POST/DELETE endpoint and
      # is intentionally absent from the branch-protection PUT body.
      signature_protection |
      {
        required_status_checks: (.required_status_checks | status_checks),
        enforce_admins: enabled("enforce_admins"; false),
        required_pull_request_reviews: (.required_pull_request_reviews | pull_request_reviews),
        restrictions: (.restrictions | access_list),
        required_linear_history: enabled("required_linear_history"; false),
        allow_force_pushes: enabled("allow_force_pushes"; false),
        allow_deletions: enabled("allow_deletions"; false),
        block_creations: enabled("block_creations"; false),
        required_conversation_resolution: enabled("required_conversation_resolution"; false),
        lock_branch: enabled("lock_branch"; false),
        allow_fork_syncing: enabled("allow_fork_syncing"; false)
      }
    '
}

check_settings() {
    local repo="$1" auto_delete default_branch protection protection_status=0
    echo -e "${BLUE}リポジトリ: ${repo}${NC}"
    echo ""

    if ! auto_delete=$(gh api "repos/${repo}" --jq '.delete_branch_on_merge' 2>/dev/null); then
        echo -e "${YELLOW}!${NC} PRマージ後のブランチ自動削除: 取得に失敗"
        protection_status=1
    elif [[ "$auto_delete" == "true" ]]; then
        echo -e "${GREEN}✓${NC} PRマージ後のブランチ自動削除: 有効"
    else
        echo -e "${YELLOW}✗${NC} PRマージ後のブランチ自動削除: 無効"
    fi

    if ! default_branch=$(get_default_branch "$repo"); then
        return 1
    fi
    if protection=$(get_branch_protection "$repo" "$default_branch"); then
        echo -e "${GREEN}✓${NC} ${default_branch}ブランチ保護: 有効"
        if jq -e '.required_pull_request_reviews != null' <<<"$protection" >/dev/null 2>&1; then
            echo "    - PR必須: 有効"
        fi
    else
        case $? in
            2) echo -e "${YELLOW}✗${NC} ${default_branch}ブランチ保護: 無効" ;;
            *)
                echo -e "${YELLOW}!${NC} ${default_branch}ブランチ保護: 取得に失敗"
                protection_status=1
                ;;
        esac
    fi
    return "$protection_status"
}

apply_settings() {
    local repo="$1" default_branch protection path payload protection_status
    echo -e "${BLUE}リポジトリ: ${repo}${NC}"
    echo ""

    default_branch=$(get_default_branch "$repo") || return 1
    if protection=$(get_branch_protection "$repo" "$default_branch"); then
        if ! payload=$(existing_protection_payload <<<"$protection"); then
            echo -e "${RED}✗${NC} 既存のブランチ保護を安全に保持できないため更新を中止しました" >&2
            return 1
        fi
    else
        protection_status=$?
        if [[ "$protection_status" -eq 2 ]]; then
            payload=$(default_protection_payload)
        else
            echo -e "${RED}✗${NC} ブランチ保護の取得に失敗したため更新を中止しました" >&2
            return 1
        fi
    fi

    path=$(branch_protection_path "$repo" "$default_branch")
    echo -e "${BLUE}PRマージ後のブランチ自動削除を設定中...${NC}"
    if gh api "repos/${repo}" -X PATCH -f delete_branch_on_merge=true >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} ブランチ自動削除を有効化しました"
    else
        echo -e "${RED}✗${NC} ブランチ自動削除の設定に失敗しました"
    fi
    echo -e "${BLUE}${default_branch}ブランチの保護を設定中...${NC}"
    if printf '%s\n' "$payload" | gh api "$path" -X PUT --input - >/dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} ${default_branch}ブランチを保護しました"
        echo "    - 既存の保護設定を維持"
        echo "    - PR経由でのマージを必須化"
    else
        echo -e "${YELLOW}!${NC} ブランチ保護の設定に失敗しました (権限不足の可能性)"
        return 1
    fi
}

main() {
    local check_only=false repo=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --check) check_only=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) echo -e "${RED}不明なオプション: $1${NC}" >&2; usage; exit 1 ;;
            *) repo="$1"; shift ;;
        esac
    done
    if ! command -v gh &>/dev/null; then
        echo -e "${RED}エラー: gh コマンドがインストールされていません${NC}" >&2
        exit 1
    fi
    if ! gh auth status &>/dev/null; then
        echo -e "${RED}エラー: gh auth login で認証してください${NC}" >&2
        exit 1
    fi
    repo=$(get_repo_name "$repo") || exit 1
    if $check_only; then check_settings "$repo"; else apply_settings "$repo"; fi
}

main "$@"
