#!/bin/bash
#
# git-new-feature - 機能ブランチを作成するスクリプト
#
# 使い方:
#   git-new-feature 機能名     # feat/機能名 ブランチを作成
#   git-new-feature -f 機能名  # fix/機能名 ブランチを作成
#   git-new-feature -d 機能名  # docs/機能名 ブランチを作成
#
# 機能:
#   - main ブランチを最新に更新
#   - 新しいブランチを作成して切り替え

set -euo pipefail

# 色定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# notes ファイルを雛形から生成
# opus-47-policy.md「File-System Memory」規約に基づく
# - _template.md がなければ警告のみ (ブランチ作成は完了済み)
# - 既存ファイルがあれば上書きしない (冪等)
# - macOS BSD sed / GNU sed 両対応
init_notes_for_branch() {
    local branch="$1"
    local task_id="${branch//\//-}"
    local notes_file=".claude/notes/${task_id}.md"

    # 既に存在すればスキップ
    if [[ -f "$notes_file" ]]; then
        echo -e "${YELLOW}! notes ファイルが既に存在: ${notes_file} (スキップ)${NC}"
        return 0
    fi

    # テンプレートを探す: ローカル → グローバル → テンプレートソース
    local template_file=""
    for candidate in \
        ".claude/notes/_template.md" \
        "${HOME}/.claude/notes/_template.md" \
        "${HOME}/.claude/templates/project-init/notes/_template.md"
    do
        if [[ -f "$candidate" ]]; then
            template_file="$candidate"
            break
        fi
    done

    if [[ -z "$template_file" ]]; then
        echo -e "${YELLOW}! _template.md が見つかりません${NC}"
        echo -e "${YELLOW}  notes ファイル生成をスキップします${NC}"
        echo -e "${YELLOW}  プロジェクト初期化が未済の場合は 'claude-init-project' を実行してください${NC}"
        return 0
    fi

    # コピー + プレースホルダ置換 (macOS / Linux 両対応)
    mkdir -p "$(dirname "$notes_file")"
    cp "$template_file" "$notes_file"

    local today
    today=$(date +%Y-%m-%d)
    if sed --version >/dev/null 2>&1; then
        sed -i \
            -e "s|{task-id}|${task_id}|g" \
            -e "s|{branch-name}|${branch}|g" \
            -e "s|YYYY-MM-DD|${today}|" \
            "$notes_file"
    else
        sed -i '' \
            -e "s|{task-id}|${task_id}|g" \
            -e "s|{branch-name}|${branch}|g" \
            -e "s|YYYY-MM-DD|${today}|" \
            "$notes_file"
    fi

    echo -e "${GREEN}✓ notes ファイルを生成: ${notes_file}${NC}"
    echo -e "${GRAY}  template: ${template_file}${NC}"
}

# 使い方を表示
usage() {
    cat <<EOF
使い方: git-new-feature [オプション] <ブランチ名>

オプション:
  -f, --fix       fix/ プレフィックスを使用 (バグ修正)
  -d, --docs      docs/ プレフィックスを使用 (ドキュメント)
  -r, --refactor  refactor/ プレフィックスを使用 (リファクタリング)
  -c, --chore     chore/ プレフィックスを使用 (雑務)
  -h, --help      このヘルプを表示

例:
  git-new-feature add-login      # feat/add-login を作成
  git-new-feature -f typo        # fix/typo を作成
EOF
}

# メイン関数
main() {
    local prefix="feat"
    local branch_name=""
    local main_branch

    # 引数解析
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f| --fix)
                prefix="fix"
                shift
                ;;
            -d| --docs)
                prefix="docs"
                shift
                ;;
            -r| --refactor)
                prefix="refactor"
                shift
                ;;
            -c| --chore)
                prefix="chore"
                shift
                ;;
            -h| --help)
                usage
                exit 0
                ;;
            -*)
                echo -e "${RED}不明なオプション: $1${NC}" >&2
                usage
                exit 1
                ;;
            *)
                branch_name="$1"
                shift
                ;;
        esac
    done

    # ブランチ名が指定されているか確認
    if [[ -z "$branch_name" ]]; then
        echo -e "${RED}エラー: ブランチ名を指定してください${NC}" >&2
        usage
        exit 1
    fi

    # ブランチ名にASCII英数字・ハイフン・アンダースコア・ドット・スラッシュ以外が含まれていないか確認
    if [[ "$branch_name" =~ [^a-zA-Z0-9._/-] ]]; then
        printf "${RED}エラー: ブランチ名に使用できない文字が含まれています: %s${NC}\n" "$branch_name" >&2
        echo -e "${YELLOW}使用可能: 英数字, ハイフン(-), アンダースコア(_), ドット(.), スラッシュ(/)${NC}" >&2
        exit 1
    fi

    # Git リポジトリ内か確認
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo -e "${RED}エラー: Git リポジトリ内で実行してください${NC}" >&2
        exit 1
    fi

    # メインブランチを取得
    main_branch=$(git config --local --get claude.mainBranch 2>/dev/null || echo "")
    if [[ -z "$main_branch" ]]; then
        main_branch=$(git remote show origin 2>/dev/null | grep 'HEAD branch' | awk '{print $NF}' || true)
        if [[ -z "$main_branch" ]]; then
            main_branch="main"
        fi
    fi

    local full_branch_name="${prefix}/${branch_name}"

    echo -e "${BLUE}メインブランチ: ${main_branch}${NC}"
    echo -e "${BLUE}新しいブランチ: ${full_branch_name}${NC}"
    echo ""

    # ① main を最新化 (新ブランチ作成「前」)
    echo -e "${BLUE}${main_branch} を最新化中...${NC}"
    git switch "$main_branch"
    if git remote get-url origin &>/dev/null; then
        git fetch origin "$main_branch"
        git pull --ff-only origin "$main_branch"
    else
        echo -e "${YELLOW}! リモート (origin) が未設定のため fetch/pull をスキップしました${NC}"
    fi

    # ② 新しいブランチを作成
    echo ""
    echo -e "${BLUE}ブランチを作成中...${NC}"
    git switch -c "$full_branch_name"

    # ③ notes 自動生成
    init_notes_for_branch "$full_branch_name"

    echo ""
    echo -e "${GREEN}✓ ${full_branch_name} を作成しました${NC}"

    # 完了メッセージ
    echo ""
    echo "作業が終わったら:"
    echo "  1. git add . && git commit -m 'メッセージ'"
    echo "  2. git push -u origin ${full_branch_name}"
    echo "  3. gh pr create"
    echo "  4. マージ後: git-cleanup-branch"
}
main "$@"
